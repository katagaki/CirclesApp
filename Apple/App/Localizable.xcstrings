        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backs up automatically when you close the app, at most once an hour."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを閉じたときに、1時間に1回まで自動でバックアップされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 닫을 때 한 시간에 한 번까지 자동으로 백업됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭应用时自动备份，每小时最多一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉App時自動備份，每小時最多一次。"
