    "Route.NoStops.Message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add circles in this hall to your favorites to plan a route."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このホールのサークルをお気に入りに追加すると、ルートを作成できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 홀의 서클을 즐겨찾기에 추가하면 경로를 만들 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将此展厅的社团加入收藏后即可规划路线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將此展廳的社團加入收藏後即可規劃路線。"
          }
        }
      }
    },
    "Route.NoStops.Title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Favorites to Visit"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回るお気に入りがありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
