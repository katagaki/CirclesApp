          "stringUnit": {
            "state": "translated",
            "value": "This device can't scan QR codes. Ask whoever shared the list to send you the join link instead."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 기기는 QR 코드 스캔을 지원하지 않습니다. 목록을 공유한 사람에게 참가 링크를 보내 달라고 하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
