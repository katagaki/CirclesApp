        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不恢复"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不還原"
          }
        }
      }
    },
    "Alerts.Backup.Restore.Title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore From Backup?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップから復元しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업에서 복원할까요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要从备份恢复吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要從備份還原嗎？"
          }
        }
      }
    },
    "Alerts.CircleNotInMap.Title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This circle is not present in the selected hall."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択された棟にこのサークルはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 서클은 선택한 홀에 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该社团不在所选展厅中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該社團不在所選展廳中。"
          }
        }
      }
