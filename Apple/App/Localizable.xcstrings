    "Alerts.Backup.Restore.Message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An iCloud backup was found for this account. Restoring will bring back your visits, buys, attachments and settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントのiCloudバックアップが見つかりました。復元すると、訪問状況、宝物、添付ファイル、設定が戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정의 iCloud 백업을 찾았습니다. 복원하면 방문 기록, 구매 목록, 첨부파일, 설정이 복구됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找到了此账户的iCloud备份。恢复后将还原访问记录、宝贝、附件和设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找到了此帳號的iCloud備份。還原後將復原造訪紀錄、寶藏、附件和設定。"
          }
        }
      }
    },
    "Alerts.Backup.Restore.Restore": {
      "extractionState": "manual",
      "localizations": {
