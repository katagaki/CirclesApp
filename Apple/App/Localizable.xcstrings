      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Next as you go, here or on the Lock Screen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「次へ」で進みます。ロック画面からも操作できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'다음'을 눌러 진행하세요. 잠금 화면에서도 조작할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按“下一步”前进，也可在锁定屏幕上操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點按「下一步」前進，也可在鎖定畫面上操作。"
          }
        }
      }
    },
