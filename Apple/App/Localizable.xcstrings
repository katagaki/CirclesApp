    "More.Backup.Restore.From %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loads from the backup made on %@. Nothing on this device is deleted."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@のバックアップから読み込みます。この端末にあるデータは削除されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 만든 백업을 불러옵니다. 이 기기의 데이터는 삭제되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将从%@的备份中载入。不会删除此设备上的数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將從%@的備份中載入。不會刪除此裝置上的資料。"
          }
        }
      }
    },
