        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll need to scan the QR code again to rejoin."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "다시 참가하려면 QR 코드를 다시 스캔해야 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "若要重新加入，需要再次扫描二维码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "若要重新加入，需要再次掃描 QR 碼。"
          }
        }
      }
    },
