    "Alerts.Logout.Message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you sign in again, map and circle data will need to be downloaded again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再度ログインすると、マップとサークルデータのダウンロードが再度行われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 로그인하면 지도와 서클 데이터를 다시 다운로드해야 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再次登录时，需要重新下载地图和摊位数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再次登入時，需要重新下載地圖和攤位資料。"
          }
        }
      }
    },
    "Alerts.Logout.Title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are You Sure You Want To Sign Out?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログアウトしますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그아웃하시겠습니까?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确定要登出吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確定要登出嗎？"
          }
        }
      }
    },
    "Alerts.OfflineMode.Download.Message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Data for this event has not been downloaded. Exit offline mode and sign in to download it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このイベントのデータはダウンロードされていません。オフラインモードを終了してログインすると、ダウンロードできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 이벤트의 데이터가 다운로드되어 있지 않습니다. 오프라인 모드를 종료하고 로그인하면 다운로드할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未下载此活动的数据。退出离线模式并登录后即可下载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未下載此活動的資料。結束離線模式並登入後即可下載。"
          }
        }
      }
    },
    "Alerts.OfflineMode.Download.Title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads Unavailable In Offline Mode"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフラインモードではダウンロードできません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인 모드에서는 다운로드할 수 없습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离线模式下无法下载"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "離線模式下無法下載"
          }
        }
      }
    },
    "Alerts.OfflineMode.Enter.Message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In offline mode, you can use CiRCLES for 3 days with previously downloaded event data. After that, you will need to sign in again. Favorites cannot be edited in offline mode."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフラインモードでは、事前にダウンロードしたイベントデータを使用して、3日間サークルズをご利用いただけます。期限が過ぎると、再度ログインが必要になります。なお、オフラインモードではお気に入りの編集はできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인 모드에서는 미리 다운로드한 이벤트 데이터를 사용하여 3일 동안 CiRCLES를 이용할 수 있습니다. 기간이 지나면 다시 로그인해야 합니다. 오프라인 모드에서는 즐겨찾기를 편집할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在离线模式下，您可以使用事先下载的活动数据继续使用CiRCLES 3天。到期后需要重新登录。离线模式下无法编辑收藏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在離線模式下，您可以使用事先下載的活動資料繼續使用CiRCLES 3天。到期後需要重新登入。離線模式下無法編輯收藏。"
          }
        }
      }
    },
    "Alerts.OfflineMode.Enter.Title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are You At The Venue?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会場にいますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "행사장에 계신가요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您在会场吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您在會場嗎？"
          }
        }
      }
    },
    "Alerts.OfflineMode.Exit.Message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You will need to sign in again after exiting offline mode."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終了すると、再度ログインが必要になります。"
