    "Buys.Guest.NotJoined.Description": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共同購入リストのQRコードを読み取ると、リストの中身を見て、買えたものにチェックを付けられます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan a shared list's QR code to see what's on it and tick off the things you've bought."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "공유 목록의 QR 코드를 스캔하면 목록을 보고 구매한 항목에 체크할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "扫描共享列表的二维码，即可查看列表内容并勾选已购买的物品。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "掃描共享清單的 QR 碼，即可檢視清單內容並勾選已購買的物品。"
          }
        }
      }
    },
    "Buys.Guest.ReadOnly": {
      "extractionState": "manual",
      "localizations": {
