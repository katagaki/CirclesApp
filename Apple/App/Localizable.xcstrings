          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還原"
          }
        }
      }
    },
