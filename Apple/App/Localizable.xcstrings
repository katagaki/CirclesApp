    "Alerts.DownloadConfirmation.Message %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will download approximately %@ of data."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "約%@のデータをダウンロードします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "약 %@의 데이터를 다운로드합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将下载约%@的数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將下載約%@的資料。"
          }
        }
      }
    },
