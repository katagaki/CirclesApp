    "More.Backup.Contents.Description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Circle data from the Web Catalog is not included. You can download it again from Event Data at any time."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウェブカタログのサークル情報は含まれません。イベントデータからいつでも再ダウンロードできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "웹 카탈로그의 서클 정보는 포함되지 않습니다. 이벤트 데이터에서 언제든지 다시 다운로드할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不包含网页目录的社团信息。可随时从活动数据重新下载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不包含網頁型錄的社團資訊。可隨時從活動資料重新下載。"
          }
        }
      }
    },
