    "Alerts.Guest.Exit.Message": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "参加中のリストから退出し、ゲスト用の名前も破棄されます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll leave the list you're in, and the guest name you were given will be discarded."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "참가 중인 목록에서 나가고, 부여받은 게스트 이름도 삭제됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你将退出所在的列表，分配给你的访客名称也会被丢弃。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你將退出所在的清單，指派給你的訪客名稱也會被捨棄。"
          }
        }
      }
    },
    "Alerts.Guest.Exit.Title": {
