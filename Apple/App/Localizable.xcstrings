    "Favorites.WebCatalogFavorites": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About favorites added from the Web Catalog"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Webカタログからの登録について"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Web 카탈로그에서 등록한 즐겨찾기에 대하여"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
