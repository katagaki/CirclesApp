    "Alerts.Guest.Leave.Message": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度参加するには、QRコードを読み取り直す必要があります。"
          }
