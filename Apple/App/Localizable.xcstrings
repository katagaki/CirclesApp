    "Notifier.Explainer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set notifications before the event starts, when the event starts, and when the event ends. Settings may vary depending on the ticket you selected."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "イベント開催前、開催時、閉会時の通知が設定できます。設定できる通知は、チケット（参加時間）によって異なります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이벤트 시작 전, 시작 시, 종료 시 알림을 설정합니다. 설정은 선택한 티켓에 따라 달라질 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设定活动开始前、开始时和结束时的通知。设定可能会依您选择的票券而有所不同。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定活動開始前、開始時和結束時的通知。設定可能會依您選擇的票券而有所不同。"
          }
        }
      }
    },
