    "Hero.Favorites.Description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Assign colors to your favorite circles and easily find them on the day of the Comic Market"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "好きなサークルに色付けて、コミケ当日に簡単に見分ける"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "즐겨찾는 서클에 색상을 지정하여 코미케 당일 쉽게 찾을 수 있습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为您最喜爱的摊位分配颜色，在Comic Market当天轻松找到它们"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為您最喜愛的攤位分配顏色，在Comic Market當天輕鬆找到它們"
          }
        }
      }
    },
