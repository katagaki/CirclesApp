    "Buys.Shared.Explain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your own Buys stay private. A shared list is a separate list that everyone in the session can see and edit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の宝物リストは非公開のままです。共同購入リストは、参加者全員が見て編集できる別のリストです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "내 구매 목록은 비공개로 유지됩니다. 공유 목록은 참가자 모두가 보고 편집할 수 있는 별도의 목록입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你自己的宝贝清单仍为私密。共享列表是所有参与者都能查看和编辑的另一个列表。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你自己的寶藏清單仍為私密。共享清單是所有參與者都能檢視和編輯的另一個清單。"
          }
        }
      }
    },
