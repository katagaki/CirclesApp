    "Buys.Guest.Scan.Unsupported.Description": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末はQRコードの読み取りに対応していません。リストを共有した人に参加用リンクを送ってもらってください。"
          }
        },
