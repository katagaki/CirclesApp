    "Route.Trapped.Message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your surroundings and wait. A route will appear here as soon as the way opens."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "周囲の状況を確認して、しばらくお待ちください。通れるようになり次第、ここにルートが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주변 상황을 확인하고 잠시 기다려 주세요. 길이 열리는 대로 여기에 경로가 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请留意周围情况并稍候。通道开放后，路线会立即显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請留意周圍情況並稍候。通道開放後，路線會立即顯示在這裡。"
          }
        }
      }
    },
