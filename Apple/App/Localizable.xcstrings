    "Route.Priority.Footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a color to include or leave it out, and drag it to change the order. Numbered colors are visited first to last."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップで回るかどうかを切り替え、ドラッグで順番を入れ替えます。番号の順に回ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "색을 눌러 포함하거나 제외하고, 드래그해서 순서를 바꾸세요. 번호 순서대로 방문합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按颜色可选择是否前往，拖动可调整顺序。将按编号顺序前往。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點按顏色可選擇是否前往，拖動可調整順序。將依編號順序前往。"
          }
        }
      }
    },
