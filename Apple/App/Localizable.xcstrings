        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遇到封閉就繞行"
          }
        }
      }
    },
    "Route.Onboarding.Modes.Message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic takes the shortest walk. Choose Colors goes color by color."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「おまかせ」は最短で、「色を選択」は色の順に回ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'자동'은 최단 동선으로, '색상 선택'은 색 순서대로 돕니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“自动”走最短路线，“选择颜色”按颜色顺序前往。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「自動」走最短路線，「選擇顏色」依顏色順序前往。"
          }
        }
      }
    },
