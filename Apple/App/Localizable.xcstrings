    "Route.Onboarding.Detour.Message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Detour for another way, or long-press the map to close off a hall."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「迂回」をタップすると、別の道を案内します。ホールごと閉じるときは、マップを長押ししてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'우회'을 누르면 다른 길로 안내합니다. 홀 전체를 막으려면 지도를 길게 누르세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按“绕行”换条路；要封闭整个展厅，请长按地图。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點按「繞行」換條路；要封閉整個展廳，請長按地圖。"
          }
        }
      }
    },
    "Route.Onboarding.Detour.Title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Detour Around Closures"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通れないときは迂回"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "막혔을 때는 우회"
