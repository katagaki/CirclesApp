    "Your own Buys stay private. A shared list is a separate list that everyone in the session can see and edit.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の宝物リストは非公開のままです。共有リストは、参加者全員が見て編集できる別のリストです。"
          }
        }
      }
    },
    "Your share": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの分"
          }
        }
      }
