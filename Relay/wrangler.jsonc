{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "circles-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "observability": { "enabled": true },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "vars": {
    "APNS_TEAM_ID": "YYM4Z6MU8F",
    "APNS_TOPIC": "com.tsubuzaki.CiRCLES",
    "ATTEST_MODE": "off",
    "APP_ATTEST_TEAM_ID": "YYM4Z6MU8F",
    "APP_ATTEST_BUNDLE_ID": "com.tsubuzaki.CiRCLES",
    "APP_ATTEST_ENVIRONMENT": "production",
    "PLAY_PACKAGE_NAME": "com.tsubuzaki.circlesgo",
    "PLAY_MIN_VERDICT": "device"
  },
  "env": {
    "staging": {
      "name": "circles-relay-beta",
      "observability": { "enabled": true },
      "vars": {
        "APNS_TEAM_ID": "YYM4Z6MU8F",
        "APNS_TOPIC": "com.tsubuzaki.CiRCLES",
        "ATTEST_MODE": "off",
        "APP_ATTEST_TEAM_ID": "YYM4Z6MU8F",
        "APP_ATTEST_BUNDLE_ID": "com.tsubuzaki.CiRCLES",
        "APP_ATTEST_ENVIRONMENT": "development",
        "PLAY_PACKAGE_NAME": "com.tsubuzaki.circlesgo",
        "PLAY_MIN_VERDICT": "device"
      },
      "durable_objects": {
        "bindings": [{ "name": "ROOM", "class_name": "Room" }]
      }
    },
    "production": {
      "name": "circles-relay",
      "observability": { "enabled": true },
      "vars": {
        "APNS_TEAM_ID": "YYM4Z6MU8F",
        "APNS_TOPIC": "com.tsubuzaki.CiRCLES",
        "ATTEST_MODE": "off",
        "APP_ATTEST_TEAM_ID": "YYM4Z6MU8F",
        "APP_ATTEST_BUNDLE_ID": "com.tsubuzaki.CiRCLES",
        "APP_ATTEST_ENVIRONMENT": "production",
        "PLAY_PACKAGE_NAME": "com.tsubuzaki.circlesgo",
        "PLAY_MIN_VERDICT": "device"
      },
      "durable_objects": {
        "bindings": [{ "name": "ROOM", "class_name": "Room" }]
      }
    }
  }
}
