    "OnHand.Map.Unavailable.Description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open CiRCLES on your iPhone to send maps here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneのCiRCLESを開くと、マップがここに送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone에서 CiRCLES를 열면 지도가 여기로 전송됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 上打开 CiRCLES，即可将地图发送到这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 上開啟 CiRCLES，即可將地圖傳送到這裡。"
          }
        }
      }
    },
